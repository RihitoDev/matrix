{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "prepare": "cd .. && husky",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "migrate": "prisma migrate dev --name",
    "migrate:apply": "prisma migrate deploy && prisma generate",
    "seed": "prisma db seed",
    "seed:run": "tsc -p tsconfig.seed.json && node dist-seed/src/common/database/seeds.js",
    "vercel-build": "prisma generate && pnpm vercel:migrate && pnpm build",
    "vercel:migrate": "sh -c 'if [ \"$VERCEL_ENV\" = \"production\" ]; then prisma migrate deploy; else echo \"vercel:migrate skipped (VERCEL_ENV=$VERCEL_ENV)\"; fi'",
    "generate": "prisma generate",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "dotenv run -f .env.test -- vitest run --config ./vitest.config.e2e.ts",
    "migrate:test:apply": "dotenv run -f .env.test -- pnpm migrate:apply",
    "test:all": "concurrently \"pnpm test\" \"pnpm test:e2e\"",
    "lint:standards": "eslint \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.4",
    "eslint": "^10.11.0",
    "eslint-plugin-check-file": "^3.3.2",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript-eslint": "^8.70.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/mau": "^0.2.8",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11"
  }
}
