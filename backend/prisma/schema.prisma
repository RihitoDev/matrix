generator client {
  provider = "prisma-client"
  output   = "../src/prisma"
}

datasource db {
  provider = "postgresql"
}

model AppointmentStatus {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @unique @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  appointments                 Appointment[]
  previousAppointmentHistories AppointmentHistory[] @relation("PreviousAppointmentStatus")
  newAppointmentHistories      AppointmentHistory[] @relation("NewAppointmentStatus")

  @@map("appointment_statuses")
}

model ProposalStatus {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @unique @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  proposals TimeProposal[]

  @@map("proposal_statuses")
}

model EventModality {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @unique @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  events Event[]

  @@map("event_modalities")
}

model EventOrigin {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @unique @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  events Event[]

  @@map("event_origins")
}

model EventStatus {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @unique @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  events Event[]

  @@map("event_statuses")
}

model RegistrationStatus {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @unique @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  eventRegistrations EventRegistration[]

  @@map("registration_statuses")
}

model City {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @unique @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users User[]

  @@map("cities")
}

model Company {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @unique @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workExperiences WorkExperience[]
  jobOffers       JobOffer[]

  @@map("companies")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  firstName     String   @map("first_name") @db.VarChar(100)
  lastName      String   @map("last_name") @db.VarChar(100)
  email         String   @unique @db.VarChar(150)
  password      String?  @db.VarChar(255)
  isActive      Boolean  @default(true) @map("is_active")
  isAvailableForMentoring  Boolean  @default(false) @map("is_available_for_mentoring")
  photoUrl      Bytes?   @map("photo_url")
  cityId        String?  @map("city_id") @db.Uuid
  phone         String?
  personalEmail String?  @map("personal_email")
  headline      String?
  aboutMe       String?  @map("about_me")
  cvPdfUrl      Bytes?   @map("cv_pdf_url")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  city City? @relation(fields: [cityId], references: [id], onDelete: SetNull)

  roles           UserRole[]
  educations      Education[]
  workExperiences WorkExperience[]
  userSkills      UserSkill[]
  certifications  Certification[]

  mentorTechnicalAreas   MentorTechnicalArea[]
  mentorOrientationTypes MentorOrientationType[]
  availabilityBlocks     AvailabilityBlock[]
  blockedDates           BlockedDate[]

  mentorAppointments    Appointment[]        @relation("AppointmentMentor")
  studentAppointments   Appointment[]        @relation("AppointmentStudent")
  cancelledAppointments Appointment[]        @relation("AppointmentCancelledBy")
  appointmentChanges    AppointmentHistory[]

  createdEvents        Event[]             @relation("EventCreatedBy")
  moderatedEvents      Event[]             @relation("EventModeratedBy")
  eventRegistrations   EventRegistration[]
  checkedInAttendances EventAttendance[]

  reviewedAccessRequests AccessRequest[] @relation("AccessRequestReviewedBy")

  @@index([cityId])
  @@map("users")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  startAt   DateTime  @default(now()) @map("start_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, startAt])
  @@index([roleId])
  @@index([userId])
  @@map("user_roles")
}

model Education {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  institution String
  degree      String
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("educations")
}

model WorkExperience {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  position    String
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  isCurrent   Boolean   @default(false) @map("is_current")
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([companyId])
  @@map("work_experiences")
}

model Skill {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isCustom  Boolean  @default(false) @map("is_custom")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userSkills     UserSkill[]
  jobOfferSkills JobOfferSkill[]

  @@map("skills")
}

model JobOfferSkill {
  id         String   @id @default(uuid()) @db.Uuid
  jobOfferId String   @map("job_offer_id") @db.Uuid
  skillId    String   @map("skill_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  jobOffer JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([jobOfferId, skillId])
  @@index([skillId])
  @@map("job_offer_skills")
}

model UserSkill {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

model Certification {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  name                String
  issuingOrganization String   @map("issuing_organization")
  issueDate           DateTime @map("issue_date") @db.Date
  documentUrl         Bytes?   @map("document_url")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("certifications")
}

model TechnicalArea {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(80)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  mentors MentorTechnicalArea[]

  @@map("technical_areas")
}

model OrientationType {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(60)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  mentors      MentorOrientationType[]
  appointments Appointment[]

  @@map("orientation_types")
}

model MentorTechnicalArea {
  id              String   @id @default(uuid()) @db.Uuid
  mentorId        String   @map("mentor_id") @db.Uuid
  technicalAreaId String   @map("technical_area_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  mentor        User          @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  technicalArea TechnicalArea @relation(fields: [technicalAreaId], references: [id], onDelete: Restrict)

  @@unique([mentorId, technicalAreaId])
  @@index([technicalAreaId])
  @@map("mentor_technical_areas")
}

model MentorOrientationType {
  id                String   @id @default(uuid()) @db.Uuid
  mentorId          String   @map("mentor_id") @db.Uuid
  orientationTypeId String   @map("orientation_type_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  mentor          User            @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  orientationType OrientationType @relation(fields: [orientationTypeId], references: [id], onDelete: Restrict)

  @@unique([mentorId, orientationTypeId])
  @@index([orientationTypeId])
  @@map("mentor_orientation_types")
}

model AvailabilityBlock {
  id          String    @id @default(uuid()) @db.Uuid
  mentorId    String    @map("mentor_id") @db.Uuid
  startAt     DateTime  @map("start_at") @db.Timestamptz(6)
  endAt       DateTime  @map("end_at") @db.Timestamptz(6)
  seriesId    String?   @map("series_id") @db.Uuid
  repeatUntil DateTime? @map("repeat_until") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  mentor       User           @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  proposals    TimeProposal[]

  @@index([mentorId, startAt])
  @@index([seriesId])
  @@map("availability_blocks")
}

model BlockedDate {
  id        String   @id @default(uuid()) @db.Uuid
  mentorId  String   @map("mentor_id") @db.Uuid
  blockedOn DateTime @map("blocked_on") @db.Date
  reason    String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  mentor User @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@unique([mentorId, blockedOn])
  @@map("blocked_dates")
}

model Appointment {
  id                String    @id @default(uuid()) @db.Uuid
  blockId           String?   @map("block_id") @db.Uuid
  mentorId          String    @map("mentor_id") @db.Uuid
  studentId         String    @map("student_id") @db.Uuid
  startAt           DateTime  @map("start_at") @db.Timestamptz(6)
  endAt             DateTime  @map("end_at") @db.Timestamptz(6)
  statusId          String    @map("status_id") @db.Uuid
  orientationTypeId String?   @map("orientation_type_id") @db.Uuid
  message           String?   @db.VarChar(300)
  rejectionReason   String?   @map("rejection_reason") @db.VarChar(300)
  meetingUrl        String?   @map("meeting_url") @db.VarChar(255)
  cancelledById     String?   @map("cancelled_by") @db.Uuid
  requestedAt       DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  respondedAt       DateTime? @map("responded_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  block           AvailabilityBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  mentor          User               @relation("AppointmentMentor", fields: [mentorId], references: [id], onDelete: Restrict)
  student         User               @relation("AppointmentStudent", fields: [studentId], references: [id], onDelete: Restrict)
  status          AppointmentStatus  @relation(fields: [statusId], references: [id], onDelete: Restrict)
  orientationType OrientationType?   @relation(fields: [orientationTypeId], references: [id], onDelete: SetNull)
  cancelledBy     User?              @relation("AppointmentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  proposals TimeProposal[]
  history   AppointmentHistory[]

  @@index([mentorId, startAt])
  @@index([studentId, startAt])
  @@index([statusId])
  @@index([blockId])
  @@map("appointments")
}

model TimeProposal {
  id              String    @id @default(uuid()) @db.Uuid
  appointmentId   String    @map("appointment_id") @db.Uuid
  proposedBlockId String    @map("proposed_block_id") @db.Uuid
  message         String?   @db.VarChar(300)
  statusId        String    @map("status_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  respondedAt     DateTime? @map("responded_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  proposedBlock AvailabilityBlock @relation(fields: [proposedBlockId], references: [id], onDelete: Cascade)
  status        ProposalStatus    @relation(fields: [statusId], references: [id], onDelete: Restrict)

  @@index([appointmentId])
  @@index([proposedBlockId])
  @@index([statusId])
  @@map("time_proposals")
}

model AppointmentHistory {
  id               String   @id @default(uuid()) @db.Uuid
  appointmentId    String   @map("appointment_id") @db.Uuid
  previousStatusId String?  @map("previous_status_id") @db.Uuid
  newStatusId      String   @map("new_status_id") @db.Uuid
  changedById      String?  @map("changed_by") @db.Uuid
  changedAt        DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  note             String?  @db.VarChar(300)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  appointment    Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  previousStatus AppointmentStatus? @relation("PreviousAppointmentStatus", fields: [previousStatusId], references: [id], onDelete: SetNull)
  newStatus      AppointmentStatus  @relation("NewAppointmentStatus", fields: [newStatusId], references: [id], onDelete: Restrict)
  changedBy      User?              @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([appointmentId, changedAt])
  @@index([previousStatusId])
  @@index([newStatusId])
  @@map("appointment_histories")
}

model EventCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  events Event[]

  @@map("event_categories")
}

model Event {
  id               String    @id @default(uuid()) @db.Uuid
  title            String    @db.VarChar(150)
  description      String?
  categoryId       String    @map("category_id") @db.Uuid
  instructorName   String?   @map("instructor_name") @db.VarChar(120)
  eventDate        DateTime  @map("event_date") @db.Date
  startTime        DateTime  @map("start_time") @db.Time(6)
  endTime          DateTime  @map("end_time") @db.Time(6)
  modalityId       String    @map("modality_id") @db.Uuid
  location         String?
  capacity         Int?
  originId         String    @map("origin_id") @db.Uuid
  statusId         String    @map("status_id") @db.Uuid
  supportThreshold Int?      @map("support_threshold")
  votingDeadline   DateTime? @map("voting_deadline") @db.Timestamptz(6)
  moderatedById    String?   @map("moderated_by") @db.Uuid
  moderationReason String?   @map("moderation_reason")
  createdById      String    @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  category    EventCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  modality    EventModality @relation(fields: [modalityId], references: [id], onDelete: Restrict)
  origin      EventOrigin   @relation(fields: [originId], references: [id], onDelete: Restrict)
  status      EventStatus   @relation(fields: [statusId], references: [id], onDelete: Restrict)
  createdBy   User          @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  moderatedBy User?         @relation("EventModeratedBy", fields: [moderatedById], references: [id], onDelete: SetNull)

  registrations EventRegistration[]

  @@index([categoryId])
  @@index([modalityId])
  @@index([originId])
  @@index([statusId])
  @@index([eventDate])
  @@map("events")
}

model EventRegistration {
  id           String    @id @default(uuid()) @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  statusId     String    @map("status_id") @db.Uuid
  qrToken      String    @unique @map("qr_token") @db.VarChar(64)
  registeredAt DateTime  @default(now()) @map("registered_at") @db.Timestamptz(6)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  event      Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     RegistrationStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  attendance EventAttendance?

  @@unique([eventId, userId])
  @@index([userId])
  @@index([statusId])
  @@map("event_registrations")
}

model EventAttendance {
  id               String    @id @default(uuid()) @db.Uuid
  registrationId   String    @unique @map("registration_id") @db.Uuid
  checkedInAt      DateTime  @map("checked_in_at") @db.Timestamptz(6)
  checkedInById    String?   @map("checked_in_by") @db.Uuid
  checkedInOffline Boolean   @default(false) @map("checked_in_offline")
  syncedAt         DateTime? @map("synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  checkedInBy  User?             @relation(fields: [checkedInById], references: [id], onDelete: SetNull)

  @@map("event_attendances")
}

model JobOffer {
  id                 String    @id @default(uuid()) @db.Uuid
  title              String    @db.VarChar(60)
  description        String
  companyId          String    @map("company_id") @db.Uuid
  modalityId         String    @map("modality_id") @db.Uuid
  contractTypeId     String    @map("contract_type_id") @db.Uuid
  statusId           String    @map("status_id") @db.Uuid
  category           String
  positionsAvailable Int       @default(1) @map("positions_available")
  salaryRange        String    @map("salary_range")
  languages          String
  locationUrl        String    @map("location_url")
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  modality     JobOfferModality     @relation(fields: [modalityId], references: [id], onDelete: Restrict)
  contractType JobOfferContractType @relation(fields: [contractTypeId], references: [id], onDelete: Restrict)
  status       JobOfferStatus       @relation(fields: [statusId], references: [id], onDelete: Restrict)
  skills       JobOfferSkill[]

  @@index([companyId])
  @@index([modalityId])
  @@index([contractTypeId])
  @@index([statusId])
  @@map("job_offers")
}

model JobOfferModality {
  id        String   @id @default(uuid()) @db.Uuid
  title     String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  jobOffers JobOffer[]

  @@map("job_offer_modalities")
}

model JobOfferContractType {
  id        String   @id @default(uuid()) @db.Uuid
  title     String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  jobOffers JobOffer[]

  @@map("job_offer_contract_types")
