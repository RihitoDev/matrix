model AccessRequest {
  id              String    @id @default(uuid()) @db.Uuid
  requestCode     String?   @unique @map("request_code") @db.VarChar(20)
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  idCardNumber    String    @map("id_card_number") @db.VarChar(20)
  idCardIssuedIn  String    @map("id_card_issued_in") @db.VarChar(2)
  sisCode         String    @map("sis_code") @db.VarChar(20)
  email           String    @db.VarChar(150)
  phone           String?   @db.VarChar(8)
  birthDate       DateTime  @map("birth_date") @db.Date
  graduationYear  Int       @map("graduation_year") @db.SmallInt
  careerId        String    @map("career_id") @db.Uuid
  statusId        String    @map("status_id") @db.Uuid
  documentTypeId  String?   @map("document_type_id") @db.Uuid
  documentFileId  String?   @unique @map("document_file_id") @db.Uuid
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(6)
  reviewedById    String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?   @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  status       AccessRequestStatus        @relation(fields: [statusId], references: [id], onDelete: Restrict)
  documentType AccessRequestDocumentType? @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  documentFile File?                      @relation(fields: [documentFileId], references: [id], onDelete: SetNull)
  reviewedBy   User?                      @relation("AccessRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  career       Career                     @relation(fields: [careerId], references: [id], onDelete: Restrict)

  activationOtps ActivationOtp[]

  @@index([statusId])
  @@index([careerId])
  @@index([sisCode])
  @@index([idCardNumber])
  @@index([email])
  @@map("access_requests")
}

model ActivationOtp {
  id              String    @id @default(uuid()) @db.Uuid
  accessRequestId String    @map("access_request_id") @db.Uuid
  codeHash        String    @map("code_hash") @db.VarChar(255)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts        Int       @default(0)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  accessRequest AccessRequest @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)

  @@index([accessRequestId])
  @@map("activation_otps")
}
