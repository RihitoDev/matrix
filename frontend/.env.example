NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_URL_LOCAL=http://localhost:8080/api
NEXT_PUBLIC_API_URL_DEV=
NEXT_PUBLIC_API_URL_PROD=
# Empresa que publica vacantes (temporal, hasta que el login de Epic 1 devuelva el companyId).
# Por defecto es TechBolivia S.R.L., tal como la crea el seed del backend (pnpm seed).
# Si la empresa ya existía en tu base con otro id, copia el de la tabla companies.
NEXT_PUBLIC_DEMO_COMPANY_ID=a0000000-0000-4000-8000-000000000001
NEXT_PUBLIC_DEMO_COMPANY_NAME=TechBolivia S.R.L.
