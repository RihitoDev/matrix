@@ -0,0 +1,77 @@
+import { Injectable } from '@nestjs/common';
+import { PrismaService } from '../../../common/prisma/prisma.service.js';
+import {
+  JOB_OFFER_CREATED_SELECT,
+  JOB_OFFER_SELECT,
+} from '../constants/job-offer.constants.js';
+import type { CreateJobOfferData } from '../types/create-job-offer-data.type.js';
+import type { JobOfferCatalogIds } from '../types/job-offer-catalog-ids.type.js';
+import { JobOfferStatus } from '../types/job-offer.enum.js';
+import type {
+  JobOfferCreatedRecord,
+  JobOfferRecord,
+} from '../types/job-offer-record.type.js';
+
+@Injectable()
+export class JobOffersRepository {
+  constructor(private readonly prisma: PrismaService) {}
+
+  async companyExists(companyId: string): Promise<boolean> {
+    const company = await this.prisma.company.findUnique({
+      where: { id: companyId },
+      select: { id: true },
+    });
+    return company !== null;
+  }
+
+  async findCatalogIds(
+    modality: string,
+    contractType: string,
+    status: string,
+  ): Promise<JobOfferCatalogIds> {
+    const [modalityRow, contractTypeRow, statusRow] = await Promise.all([
+      this.prisma.jobOfferModality.findUnique({ where: { title: modality }, select: { id: true } }),
+      this.prisma.jobOfferContractType.findUnique({
+        where: { title: contractType },
+        select: { id: true },
+      }),
+      this.prisma.jobOfferStatus.findUnique({ where: { title: status }, select: { id: true } }),
+    ]);
+
+    return {
+      modalityId: modalityRow?.id ?? null,
+      contractTypeId: contractTypeRow?.id ?? null,
+      statusId: statusRow?.id ?? null,
+    };
+  }
+
+  create(data: CreateJobOfferData): Promise<JobOfferCreatedRecord> {
+    const { skillIds, ...jobOffer } = data;
+    return this.prisma.jobOffer.create({
+      data: {
+        ...jobOffer,
+        skills: { create: skillIds.map((skillId) => ({ skillId })) },
+      },
+      select: JOB_OFFER_CREATED_SELECT,
+    });
+  }
+
+  findPublished(now: Date): Promise<JobOfferRecord[]> {
+    return this.prisma.jobOffer.findMany({
+      where: {
+        status: { title: JobOfferStatus.PUBLISHED },
+        OR: [{ expiresAt: null }, { expiresAt: { gt: now } }],
+      },
+      orderBy: { createdAt: 'desc' },
+      select: JOB_OFFER_SELECT,
+    });
+  }
+
+  findByCompany(companyId: string): Promise<JobOfferRecord[]> {
+    return this.prisma.jobOffer.findMany({
+      where: { companyId },
+      orderBy: { createdAt: 'desc' },
+      select: JOB_OFFER_SELECT,
+    });
+  }
+}
diff --git a/backend/src/modules/job-offers/requests/create-job-offer.request.ts b/backend/src/modules/job-offers/requests/create-job-offer.request.ts
new file mode 100644
index 00000000..de71c12a
--- /dev/null
+++ b/backend/src/modules/job-offers/requests/create-job-offer.request.ts
@@ -0,0 +1,59 @@
+import { z } from 'zod';
+import {
+  GOOGLE_MAPS_LINK_REGEX,
+  JOB_OFFER_DESCRIPTION_MAX_LENGTH,
+  JOB_OFFER_LANGUAGES_MAX_LENGTH,
+  JOB_OFFER_MAX_POSITIONS,
+  JOB_OFFER_MAX_SKILLS,
+  JOB_OFFER_TITLE_MAX_LENGTH,
+  JOB_OFFER_TITLE_REGEX,
+  JOB_OFFER_VALIDATION_MESSAGES as MESSAGES,
+} from '../constants/job-offer.constants.js';
+import { JobOfferContractType, JobOfferModality } from '../types/job-offer.enum.js';
+
+const salarySchema = z.number().int().min(1, MESSAGES.SALARY_NOT_POSITIVE);
+
+export const createJobOfferSchema = z
+  .object({
+    title: z
+      .string()
+      .trim()
+      .min(1, MESSAGES.REQUIRED_FIELD)
+      .max(JOB_OFFER_TITLE_MAX_LENGTH, MESSAGES.TITLE_TOO_LONG)
+      .regex(JOB_OFFER_TITLE_REGEX, MESSAGES.TITLE_INVALID_CHARACTERS),
+    description: z
+      .string()
+      .trim()
+      .min(1, MESSAGES.REQUIRED_FIELD)
+      .max(JOB_OFFER_DESCRIPTION_MAX_LENGTH, MESSAGES.DESCRIPTION_TOO_LONG),
+    modality: z.enum(JobOfferModality, { message: MESSAGES.INVALID_MODALITY }),
+    contractType: z.enum(JobOfferContractType, { message: MESSAGES.INVALID_CONTRACT_TYPE }),
+    category: z.string().trim().min(1, MESSAGES.REQUIRED_FIELD),
+    positionsAvailable: z
+      .number()
+      .int(MESSAGES.POSITIONS_NOT_INTEGER)
+      .min(1, MESSAGES.POSITIONS_TOO_FEW)
+      .max(JOB_OFFER_MAX_POSITIONS, MESSAGES.POSITIONS_TOO_MANY),
+    salaryMin: salarySchema,
+    salaryMax: salarySchema.optional(),
+    languages: z
+      .string()
+      .trim()
+      .min(1, MESSAGES.REQUIRED_FIELD)
+      .max(JOB_OFFER_LANGUAGES_MAX_LENGTH, MESSAGES.LANGUAGES_TOO_LONG),
+    locationUrl: z
+      .string()
+      .trim()
+      .min(1, MESSAGES.REQUIRED_FIELD)
+      .regex(GOOGLE_MAPS_LINK_REGEX, MESSAGES.INVALID_LOCATION_URL),
+    skillIds: z
+      .array(z.uuid(MESSAGES.INVALID_SKILL_ID))
+      .min(1, MESSAGES.SKILLS_REQUIRED)
+      .max(JOB_OFFER_MAX_SKILLS, MESSAGES.SKILLS_TOO_MANY),
+  })
+  .refine((data) => data.salaryMax === undefined || data.salaryMin <= data.salaryMax, {
+    path: ['salaryMin'],
+    message: MESSAGES.SALARY_RANGE_INVALID,
+  });
